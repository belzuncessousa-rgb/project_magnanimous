  {
    "id": "senate_reform",
    "title": "Senate Apportionment Amendment (Lessa motion)",
    "summary": "Distributes senators by population instead of three per state. Ibicuí and Tekoku gain senators; Mognagna, Ibira and Tapira lose them.",
    "note": "Seats 100. With the government 'open' (reform_stance 1) it passes narrowly; against it, it fails. OPP is against by redline.",
    "positions": {
      "pm": {
        "base": -0.2,
        "ifs": [
          {
            "when": "flag.reform_stance == 1",
            "delta": 0.3
          },
          {
            "when": "flag.reform_stance == 2 || flag.reform_stance == 3",
            "delta": -0.5
          },
          {
            "when": "flag.reform_bench_freed",
            "delta": 0.2
          }
        ]
      },
      "opp": {
        "base": -0.7
      },
      "cp": {
        "base": 0.2,
        "ifs": [
          {
            "when": "flag.great_project == 4",
            "delta": -0.2
          }
        ]
      },
      "nf": {
        "base": 0.7
      },
      "fff": {
        "base": -0.2
      },
      "ca": {
        "base": 0.9
      },
      "cv": {
        "base": -0.4,
        "ifs": [
          {
            "when": "flag.reform_stance == 1 && flag.labor_compact",
            "delta": 0.3
          }
        ]
      },
      "independents": {
        "base": 0.0
      }
    },
    "whip_costs": {
      "fff": "1 IPI",
      "independents": "1 IPI",
      "cv": "2 IPI",
      "cp": "1 IPI, 1 PT",
      "opp": "[cost: 2 IPI, 20 FC]"
    }
  },
